#!/usr/bin/env bash
set -euo pipefail
skill_dir=$(cd "$(dirname "$0")/.." && pwd -P)
archive="$skill_dir/assets/hixl-d2rh-arm64-cann9.2.1.tar.gz"
# Isolate each role invocation so a read-only skill installation works too.
work=$(mktemp -d "${TMPDIR:-/tmp}/hixl-d2rh.XXXXXXXX")
trap 'rm -rf -- "$work"' EXIT
if [[ ! -f "$archive" ]]; then
  cat "$archive".part00{1,2,3,4,5} > "$work/kit.tar.gz"
  archive="$work/kit.tar.gz"
fi
expected=04f4e3f2750e6ff93908526e9e601b9c744c5dab6019c5a44a4b5042ddf8161f
actual=$(sha256sum < "$archive")
[[ ${actual%% *} == "$expected" ]] || { echo "Offline benchmark payload checksum mismatch" >&2; exit 1; }
tar xzf "$archive" -C "$work"
"$work/hixl-d2rh/run" "$@"
